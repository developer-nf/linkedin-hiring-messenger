{
  "manifest_version": 3,
  "name": "LinkedIn Hiring Messenger",
  "version": "4.0.3",
  "description": "Helps recruiters message LinkedIn Normal and Classical Mode hiring profiles with safe, review-friendly automation.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://nikahforever.com/*",
    "http://64.227.130.94/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/hiring/applicants/*",
        "https://www.linkedin.com/hiring/jobs/*/applicants/*",
        "https://www.linkedin.com/hiring/candidates/*"
      ],
      "js": ["utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Hiring Messenger"
  }
}
